# ==========================================
# 抖音直播监控智能体 - 配置文件
# 复制此文件为 config.yaml 并填入实际值
# ==========================================

stream:
  # 捕获模式: mic=麦克风录音 / system_audio=系统音频 / stream=流抓取
  mode: "mic"
  # 音频设备索引 (macOS 查看: ffmpeg -f avfoundation -list_devices true -i "")
  audio_device: "0"
  # 音频分片时长(秒)
  chunk_duration: 30
  # 直播间URL (stream 模式必填)
  live_url: "https://live.douyin.com/YOUR_ROOM_ID"

whisper:
  # API Key
  api_key: "your-api-key"
  # API 基础地址
  base_url: "https://api.xiaomimimo.com/v1"
  # 识别模型
  model: "mimo-v2.5-asr"
  # 语言
  language: "zh"

summarize:
  # API Key
  api_key: "your-api-key"
  # API 基础地址
  base_url: "https://api.xiaomimimo.com/v1"
  # 总结模型
  model: "mimo-v2.5"
  # 总结间隔(秒)
  interval: 3600
  # 结束时是否生成完整总结
  final_summary: true

feishu:
  # 飞书机器人 Webhook URL
  webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token"

logging:
  level: "INFO"
